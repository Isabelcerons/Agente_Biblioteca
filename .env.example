PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=biblioteca_agente
PG_USER=agente_biblio
PG_PASSWORD=
# Solo para scripts de instalación (crear rol y base); la app NO los usa
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_MODEL_RESPALDO=qwen2.5:1.5b
# Modo híbrido: qwen2.5:3b decide la herramienta; este modelo redacta las respuestas con documentos
LLM_MODEL_REDACCION=qwen2.5:1.5b
EMBED_MODEL=embeddinggemma
WHISPER_MODEL=base
PIPER_VOZ=voces/es_MX-claude-high.onnx
# --- Rendimiento (Fase A) ---
# Usar 127.0.0.1 y no "localhost": en Windows localhost prueba IPv6 primero y pierde ~2 s por conexión.
# Voz alternativa mas ligera: PIPER_VOZ=voces/es_MX-ald-medium.onnx
NUM_CTX=2048
NUM_PREDICT=200
KEEP_ALIVE=30m
# Núcleos FÍSICOS de la CPU (i5-10210U: 4)
WHISPER_THREADS=4
PIPER_LENGTH_SCALE=0.92
